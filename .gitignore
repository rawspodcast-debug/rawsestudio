/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# Arquivos temporários de teste (medição de layout, renders)
/_*.html

# Lixo de sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Cache local da CLI da Vercel
.vercel/
